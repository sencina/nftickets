generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                     String    @id @default(uuid()) @db.Uuid
  address                String
  metadata_hash          String
  name                   String
  description            String
  contract_type          String    @default("NFTicket1155")
  start_date             DateTime? @db.Timestamp(6)
  end_date               DateTime? @db.Timestamp(6)
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  creator_wallet_address String
  sectors                Sector[]
  scans                  Scan[]

  @@index([address])
  @@index([creator_wallet_address])
  @@map("Event")
}

model Sector {
  id                 String   @id @default(uuid()) @db.Uuid
  event_id           String   @db.Uuid
  name               String
  description        String
  capacity           Int      @default(0)
  contract_sector_id Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  event              Event    @relation(fields: [event_id], references: [id])
  tickets            Ticket[]

  @@index([event_id])
  @@map("Sector")
}

model Ticket {
  id                     String    @id @default(uuid()) @db.Uuid
  sector_id              String    @db.Uuid
  contract_token_id      String    @default("")
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  transfer_strategy_type String    @default("NORMAL")
  transfer_strategy_data Json?
  is_used                Boolean   @default(false)
  used_at                DateTime?
  used_by                String?
  sector                 Sector    @relation(fields: [sector_id], references: [id])

  @@index([sector_id])
  @@map("Ticket")
}

model Scan {
  id                String   @id @default(uuid()) @db.Uuid
  event_id          String   @db.Uuid
  event             Event    @relation(fields: [event_id], references: [id])
  token_id          String   // Token ID being scanned
  contract_address  String   // Contract address
  scanner_address   String?  // Wallet address of scanner
  ticket_owner      String?  // Wallet address of ticket owner
  sector_name       String?  // Sector name
  scan_result       String   @default("SUCCESS") // SUCCESS, FAILED, INVALID, ALREADY_USED
  error_code        String?  // Specific error code if failed
  scanned_at        DateTime @default(now()) @db.Timestamp(6)
  location_info     Json?    // Optional location/device info

  @@index([event_id])
  @@index([scanned_at])
  @@index([scan_result])
  @@map("Scan")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  key            String    @unique
  wallet_address String
  is_active      Boolean   @default(true)
  is_used        Boolean   @default(false)
  used_at        DateTime?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  @@index([wallet_address])
  @@map("ApiKey")
}
